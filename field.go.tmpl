{{- define "field" -}}

{{- $type := .Type -}}
{{- $name := (coalesce .Name "") -}}
{{- $fieldName := $name | firstLetterToUpper -}}
{{- $keywordMap := .KeywordMap -}}
{{- $typePrefix := .TypePrefix -}}
{{- $typeMeta := .TypeMeta -}}
{{- $typeMap := .TypeMap -}}
{{- $optional := .Optional -}}
{{- $printName := .PrintName -}}
{{- $includeJsonTags := .JsonTags -}}
{{- $includeStructTags := .StructTags -}}
{{- $succinct := or .Succinct false -}}

{{- $customType := "" -}}
{{- $jsonName := $name -}}
{{- $jsonTagOverride := "" -}}
{{- $structTags := array -}}
{{- range $meta := $typeMeta -}}
    {{- if exists $meta "json" -}}
        {{- $jsonName = printf "%v" (get $meta "json") -}}
    {{- end -}}
    {{- if exists $meta "go.field.name" -}}
        {{- $fieldName = get $meta "go.field.name" -}}
    {{- end -}}
    {{- if exists $meta "go.field.type" -}}
        {{- $customType = get $meta "go.field.type" -}}
    {{- end -}}
    {{- if exists $meta "go.tag.json" -}}
        {{- $jsonTagOverride = printf "%v" (get $meta "go.tag.json") -}}
    {{- end -}}
    {{- range $metaKey, $metaValue := $meta -}}
        {{- if and (hasPrefix $metaKey "go.tag.") (ne $metaKey "go.tag.json") -}}
            {{- $structTags = append $structTags (printf "%s:%q" (trimPrefix $metaKey "go.tag.") $metaValue) -}}
        {{- end -}}
    {{- end -}}
{{- end }}

{{- /* Optional fields are omitted from JSON entirely when unset, so that clients
       can tell "absent" apart from an explicitly empty list. Skipped when the
       schema pins its own go.tag.json, or when the field is excluded already. */ -}}
{{- $omitzero := and (or .Omitzero false) $optional (ne $jsonName "-") -}}

{{- /* omitzero drops any zero value, not just an unset one, so it only says
       "absent" on a type whose zero value is nil. Left to itself an optional
       field is a pointer, a slice or a map, and all three qualify. A schema
       that pins its own Go type can land on a bare string or int, where ""
       and 0 are values a caller meant to send. */ -}}
{{- if and $omitzero (ne $customType "") -}}
    {{- $omitzero = or (hasPrefix $customType "*") (hasPrefix $customType "[]") (hasPrefix $customType "map[") -}}
{{- end -}}
{{- $jsonTag := printf "json:%q" $jsonName -}}
{{- if ne $jsonTagOverride "" -}}
    {{- $jsonTag = printf "json:%q" $jsonTagOverride -}}
{{- else if $omitzero -}}
    {{- $jsonTag = printf "json:%q" (printf "%s,omitzero" $jsonName) -}}
{{- end }}

{{- if $printName}}{{"\t"}}{{$fieldName}} {{end -}}
{{- if (ne $customType "") -}}

    {{$customType}}

{{- else if isMapType $type -}}

    map[{{mapKeyType $type}}]{{template "field" dict "Name" $name "Type" (mapValueType $type) "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $typeMeta}}

{{- else if isListType $type -}}

    []{{template "field" dict "Name" $name "Type" (listElemType $type) "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "TypeMeta" $typeMeta}}

{{- else if isCoreType $type -}}
    {{if and $optional (ne (toString $type) "any")}}*{{end}}{{ get $typeMap $type }}

{{- else -}}{{- /* structs, enums, aliases */ -}}
    {{- if or (isEnumType $type) (isAliasType $type) -}}
        {{if $optional}}*{{end}}{{$typePrefix}}{{$type}}
    {{- else -}}
        {{- if $succinct -}}
            {{$typePrefix}}{{$type}}
        {{- else -}}
            *{{$typePrefix}}{{$type}}
        {{- end -}}
    {{- end -}}
{{- end -}}

{{- if $includeJsonTags -}}
{{" "}}`{{$jsonTag}}{{if and $includeStructTags (len $structTags)}} {{join (sort $structTags) " "}}{{end}}`
{{- end -}}

{{- end -}}