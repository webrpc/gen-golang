{{- /*
    Emits the statements that give one value its empty-collection treatment.

    Required lists and maps become empty when nil, so they always serialize as
    [] or {} instead of null. Optional ones are left alone: their nil is
    meaningful and drops out of the JSON entirely via the omitzero tag.

    Structs are walked, never created. A nil required struct stays null, because
    a zero struct is a different value rather than an empty container, and
    inventing one would hide the bug that produced the nil.

    "Expr" is the Go expression to fix, so the same template serves struct
    fields (x.Foo), a method's return values (ret0), and anything reached by
    recursion (x.Foo[i0], x.Bar[k0]).
*/ -}}
{{- define "initNilSlices" -}}
{{- $expr := .Expr -}}
{{- $type := .Type -}}
{{- $optional := .Optional -}}
{{- $typeMap := .TypeMap -}}
{{- $keywordMap := .KeywordMap -}}
{{- $typePrefix := .TypePrefix -}}
{{- $typeMeta := .TypeMeta -}}
{{- $structTypes := .StructTypes -}}
{{- $depth := or .Depth 0 -}}

{{- $customType := "" -}}
{{- range $meta := $typeMeta -}}
    {{- if exists $meta "go.field.type" -}}
        {{- $customType = get $meta "go.field.type" -}}
    {{- end -}}
{{- end -}}

{{- if $optional -}}
{{- /* Nil is a value here, not a gap to fill. */ -}}

{{- else if ne $customType "" -}}
{{- /* The schema pinned its own Go type. Only a slice can take an empty
       literal; anything else (json.RawMessage, a named type, a pointer) has
       semantics we cannot know, so leave it untouched. */ -}}
{{- if hasPrefix $customType "[]" }}
	if {{$expr}} == nil {
		{{$expr}} = {{$customType}}{}
	}
{{- end -}}

{{- else if isListType $type }}
	if {{$expr}} == nil {
		{{$expr}} = {{template "field" dict "Type" $type "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix}}{}
	}
{{- $elem := listElemType $type -}}
{{- if or (exists $structTypes (printf "%v" $elem)) (isListType $elem) (isMapType $elem) }}
	for i{{$depth}} := range {{$expr}} {
		{{- template "initNilSlices" dict "Expr" (printf "%s[i%d]" $expr $depth) "Type" $elem "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "StructTypes" $structTypes "Depth" (add $depth 1) }}
	}
{{- end -}}

{{- else if isMapType $type }}
	if {{$expr}} == nil {
		{{$expr}} = {{template "field" dict "Type" $type "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix}}{}
	}
{{- $value := mapValueType $type -}}
{{- if or (exists $structTypes (printf "%v" $value)) (isListType $value) (isMapType $value) }}
	for k{{$depth}} := range {{$expr}} {
		{{- template "initNilSlices" dict "Expr" (printf "%s[k%d]" $expr $depth) "Type" $value "TypeMap" $typeMap "KeywordMap" $keywordMap "TypePrefix" $typePrefix "StructTypes" $structTypes "Depth" (add $depth 1) }}
	}
{{- end -}}

{{- else if exists $structTypes (printf "%v" $type) }}
	{{$expr}}.initNilSlices()
{{- end -}}

{{- end -}}
